{
  "manifest_version": 3,
  "name": "Kairos - Your AI Video Note-Taking Companion",
  "version": "1.0.5",
  "description": "Watch with AI. You choose what matters; Kairos helps you take notes from frames and subtitles on YouTube & Bilibili.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://www.bilibili.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.deepseek.com/*",
    "https://api.moonshot.cn/*",
    "https://openrouter.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://www.bilibili.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Kairos \u2014 Watch together. Remember more.",
    "default_popup": "src/popup.html",
    "default_icon": "icons/icon128.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "icons/*.gif"
      ],
      "matches": [
        "*://www.youtube.com/*",
        "*://www.bilibili.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  }
}
