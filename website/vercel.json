{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [ { "source": "/kairos", "destination": "/kairos/index.html" } ],
  "redirects": [ { "source": "/", "destination": "/kairos", "permanent": false } ],
  "headers": [{"source":"/kairos/:path*","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}]
}
